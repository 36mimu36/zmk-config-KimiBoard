#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

&trackball {
    automouse-layer = <2>;
    scroll-layers = <3>;
};


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // 本体180度回転に対応：ユーザーから見て左→右が BT, BS, SPACE, ENTER
                &kp ENTER  &kp SPACE  &kp BACKSPACE  &bt BT_NXT
            >;
	};

    mouse_key_layer {
            bindings = <
                &mkp RCLK  &mkp LCLK  &mkp MB3  &trans
        >;
    };

    auto_mouse_layer {
            bindings = <
                &mkp RCLK  &mkp LCLK  &mkp MB3  &trans
        >;
    };

    scroll_layer {
            bindings = <
                &trans  &trans  &trans  &trans
        >;
    };
    


    };

    combos {
        compatible = "zmk,combos";

        // Key1 + 2 = (□ - ■ ■ □)
            // タップでLANGUAGE_2へ切り替え
			// ホールドでスクロールレイヤー

        combo_layer1 {
            bindings = <&lt 3 LANGUAGE_2>;
            key-positions = <1 2>;
            timeout-ms = <50>;
        };
        
        // Key2 + 3 = (□ - □ ■ ■)
			// タップでLANGUAGE_1へ切り替え

        combo_layer2 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <0 1>;
            timeout-ms = <50>;
        };

        // Key1 + 3 = (□ -  ■ □ ■)
			// 1番レイヤーをトグル(マウス操作限定レイヤー)

        combo_layer4 {
            bindings = <&tog 1>;
            key-positions = <0 2>;
            timeout-ms = <50>;
        };

		// Key1 + 3 = (■ -  □ □　■)
			// 現在の接続先のBT接続情報を消去

        combo_layer7 {
            bindings = <&bt BT_CLR>;
            key-positions = <0 3>;
            timeout-ms = <50>;
        };


    };

};

#include <input/processors.dtsi>

&trackball_listener {
    input-processors = <&zip_xy_transform 6>;
};
