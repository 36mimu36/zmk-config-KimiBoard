#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

&trackball {
    automouse-layer = <2>;
    scroll-layers = <3>;
};


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // 本体180度回転に対応：idx 1とidx 3を入れ替え
                // ユーザー視点で左→右: 1キー(BS), 2キー(SPACE), 3キー(ENTER), 0キー(BT, 小キー右端)
                &bt BT_NXT  &kp ENTER  &kp SPACE  &kp BACKSPACE
            >;
	};

    mouse_key_layer {
            // 図(README)基準: 1キー=button2(R CLK), 2キー=button3(WHEEL), 3キー=button1(L CLK)
            bindings = <
                &trans  &mkp RCLK  &mkp MB3  &mkp LCLK
        >;
    };

    auto_mouse_layer {
            bindings = <
                &trans  &mkp RCLK  &mkp MB3  &mkp LCLK
        >;
    };

    scroll_layer {
            bindings = <
                &trans  &trans  &trans  &trans
        >;
    };
    


    };

    combos {
        compatible = "zmk,combos";

        // Key1 + 2 = (□ - ■ ■ □)
            // タップでLANGUAGE_2へ切り替え
			// ホールドでスクロールレイヤー

        combo_layer1 {
            bindings = <&lt 3 LANGUAGE_2>;
            key-positions = <2 3>;
            timeout-ms = <50>;
            layers = <0>;
        };

        // Key2 + 3 = (□ - □ ■ ■)
			// タップでLANGUAGE_1へ切り替え

        combo_layer2 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            layers = <0>;
        };

        // Key1 + 3 = (□ -  ■ □ ■)
			// 1番レイヤーをトグル(マウス操作限定レイヤー)

        combo_layer4 {
            bindings = <&tog 1>;
            key-positions = <1 3>;
            timeout-ms = <50>;
        };

		// Key1 + 3 = (■ -  □ □　■)
			// 現在の接続先のBT接続情報を消去

        combo_layer7 {
            bindings = <&bt BT_CLR>;
            key-positions = <0 1>;
            timeout-ms = <50>;
            layers = <0>;
        };

        // マウスモード中: 図の 1キー+2キー → ホイール上
        combo_scroll_up {
            bindings = <&msc SCRL_UP>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            layers = <1 2>;
        };

        // マウスモード中: 図の 2キー+3キー → ホイール下
        combo_scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <2 3>;
            timeout-ms = <50>;
            layers = <1 2>;
        };


    };

};

#include <input/processors.dtsi>

&trackball_listener {
    input-processors = <&zip_xy_transform 6>;
};
