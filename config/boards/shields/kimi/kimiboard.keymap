#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

&trackball {
    automouse-layer = <2>;
    scroll-layers = <3>;
};


/ {
    macros {
        scroll_up_fast: scroll_up_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_UP>, <&msc SCRL_UP>;
        };
        scroll_down_fast: scroll_down_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_DOWN>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // 本体180度回転に対応：idx 1とidx 3を入れ替え
                // ユーザー視点で左→右: 1キー(BS), 2キー(SPACE), 3キー(ENTER), 0キー(BT, 小キー右端)
                &bt BT_NXT  &kp ENTER  &kp SPACE  &kp BACKSPACE
            >;
	};

    mouse_key_layer {
            // 図(README)基準: 1キー=button2(R CLK), 2キー=button3(WHEEL), 3キー=button1(L CLK)
            bindings = <
                &trans  &mkp RCLK  &mkp MB3  &mkp LCLK
        >;
    };

    auto_mouse_layer {
            bindings = <
                &trans  &mkp RCLK  &mkp MB3  &mkp LCLK
        >;
    };

    scroll_layer {
            bindings = <
                &trans  &trans  &trans  &trans
        >;
    };
    


    };

    combos {
        compatible = "zmk,combos";

        // Key1 + 2 = (□ - ■ ■ □)
            // タップでLANGUAGE_2へ切り替え
			// ホールドでスクロールレイヤー

        // 旧 combo_layer1 (2+3 → LANGUAGE_2) と combo_layer2 (1+2 → LANGUAGE_1) は削除
        // スクロールコンボに位置を譲った (英数/かなは Karabiner 側で対応)

        // Key1 + 3 = (□ -  ■ □ ■)
			// 1番レイヤーをトグル(マウス操作限定レイヤー)

        combo_layer4 {
            bindings = <&tog 1>;
            key-positions = <1 3>;
            timeout-ms = <50>;
        };

		// Key1 + 3 = (■ -  □ □　■)
			// 現在の接続先のBT接続情報を消去

        combo_layer7 {
            bindings = <&bt BT_CLR>;
            key-positions = <0 1>;
            timeout-ms = <50>;
            layers = <0>;
        };

        // 図の 1キー+2キー → ホイール上 (3ティック、全レイヤー)
        combo_scroll_up {
            bindings = <&scroll_up_fast>;
            key-positions = <1 2>;
            timeout-ms = <50>;
        };

        // 図の 2キー+3キー → ホイール下 (3ティック、全レイヤー)
        combo_scroll_down {
            bindings = <&scroll_down_fast>;
            key-positions = <2 3>;
            timeout-ms = <50>;
        };


    };

};

#include <input/processors.dtsi>

&trackball_listener {
    input-processors = <&zip_xy_transform 6>;
};
